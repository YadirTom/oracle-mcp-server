# Oracle Database Connection String
# Format: username/password@host:port/service_name
ORACLE_CONNECTION_STRING=user/pass@localhost:1521/mydb

# Optional: The schema to execute queries against (defaults to connection user's schema if not specified)
# TARGET_SCHEMA=

# Optional: Cache directory for schema information (defaults to .cache)
CACHE_DIR=.cache

# Optional: oracle client lib dir.
ORACLE_CLIENT_LIB_DIR=E:\..

# MCP transport: stdio (default) | sse | streamable-http
# MCP_TRANSPORT=streamable-http
# MCP_HOST=127.0.0.1
# MCP_PORT=8000

# Logging
# LOG_CONSOLE_ENABLE=true
# LOG_CONSOLE_LEVEL=INFO
# LOG_FILE_ENABLE=true
# LOG_FILE_LEVEL=DEBUG
# LOG_DIR=logs
# LOG_ROTATION=10 MB
# LOG_RETENTION=7 days
